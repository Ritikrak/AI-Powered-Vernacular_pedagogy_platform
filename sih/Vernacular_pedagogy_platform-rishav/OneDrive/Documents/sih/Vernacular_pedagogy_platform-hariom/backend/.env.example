# Server Configuration
PORT=8000
NODE_ENV=development

# Database Configuration (Atlas Cloud or Local)
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
# Local: mongodb://localhost:27017/vernacular_classroom
MONGODB_URI=mongodb+srv://<username>:<password>@vernacular-pedagogy.xnfvhg2.mongodb.net/vernacular-pedagogy?retryWrites=true&w=majority

# Security & Authentication
JWT_SECRET=lokshiksha_vernacular_pedagogy_secure_jwt_secret_2026
JWT_EXPIRES_IN=7d

# Google Gemini AI Configuration
# Set your Gemini API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Classroom Configuration
CLASSROOM_DEFAULT_ROOM=main

# Deepgram Real-Time Speech Recognition API
# Get your API key from Deepgram Console (https://console.deepgram.com/)
# Note: For Hindi streaming ('language=hi'), 'nova-2' is required ('nova-3' is English-only).
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2
